# ── Rust ──────────────────────────────────────────────────────────────────────
/rust/target/

# ── Android JNI libs (compiled from Rust — not committed, built by scripts) ───
# These are build artifacts generated by cargo ndk / build_android.ps1.
# They are embedded into the APK at flutter build time via jniLibs.srcDirs.
# Git does not need them; CI regenerates them on every build.
/android/app/src/main/jniLibs/

# ── flutter_rust_bridge generated files ──────────────────────────────────────
# These ARE committed so teammates can build without running codegen.
# Remove from .gitignore if you want to regenerate on every CI run instead.
# lib/bridge/generated/frb_generated.dart
# lib/bridge/generated/frb_generated.io.dart
# lib/bridge/generated/frb_generated.web.dart
# rust/crates/ffi_bridge/src/frb_generated.rs

